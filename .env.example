# Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# PostgreSQL do projeto (warehouse)
# Dentro dos containers o host é "warehouse-db" e a porta 5432.
# Do Windows (pgAdmin / dbt local) use localhost e porta 5433.
WAREHOUSE_HOST=warehouse-db
WAREHOUSE_PORT=5432
WAREHOUSE_DB=urban_mobility
WAREHOUSE_USER=postgres
WAREHOUSE_PASSWORD=postgres

# Caminho da camada de dados dentro do container
DATA_DIR=/opt/airflow/data